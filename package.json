{
  "name": "belle-biens",
  "private": true,
  "description": "Belle Biens platform monorepo: NestJS API, Flutter app, shared contracts",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "pnpm --filter @belle/api",
    "contracts": "pnpm --filter @belle/contracts",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  }
}
