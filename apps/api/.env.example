# Copy to .env for local development. Values here are local defaults only, never real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://belle:belle@localhost:5433/belle?schema=public
REDIS_URL=redis://localhost:6379
APP_MIN_SUPPORTED_VERSION=1.0.0
LOG_LEVEL=debug
# Any 32+ character random string; generate one with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0000
# Development: OTP codes and emails are printed in the API log; emails also land in Mailpit (http://localhost:8025).
MESSAGING_PROVIDER=console
MAIL_SMTP_URL=smtp://localhost:1025
GOOGLE_CLIENT_IDS=
# Development only: every sign-in code is this value, for automated tests on a device.
# Refused in staging and production. Leave commented out for normal development.
# OTP_FIXED_CODE=4827
# Media store (SeaweedFS S3 from infra/docker-compose.yml). The Android emulator reaches
# your machine at 10.0.2.2, so use that host in MEDIA_PUBLIC_URL when testing on it.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=belle-media
MEDIA_PUBLIC_URL=http://localhost:8333/belle-media
