// Belle Biens data model. Entities follow SRS section 5.1 (DR-01 to DR-21) and design diagram 2.
// Models are added sprint by sprint (see docs/plan/mobile-and-backend-plan.md, section 7).
// Conventions:
//   - Table names are snake_case via @@map; ids are UUIDs.
//   - Every timestamp is timestamptz; business logic and display use Asia/Damascus (FR-LOC-03).
//   - Money is an integer in minor units plus a currency code (Int/BigInt), never a float.
//   - Orders and stock carry branchId (NFR-FLX-03).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One shop location. v1.0 has a single branch (Abu Rummaneh), kept for later growth (NFR-FLX-03).
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  timezone  String   @default("Asia/Damascus")
  /// Screen 34 / FR-CON-03.
  addressAr String   @default("") @map("address_ar")
  addressEn String   @default("") @map("address_en")
  phone     String?
  whatsapp  String?
  instagram String?
  latitude  Float?
  longitude Float?
  /// Other places customers can order from, e.g. ["Movo", "BeeOrder"].
  partners  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("branch")
}

/// DR-21: exchange rate, working hours, closed days, shop mode, limits, enabled payment methods.
/// Every change is written to the audit log (FR-ADM-09).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("setting")
}

// ---------------------------------------------------------------------------
// Accounts (S1): DR-01, FR-ACC-01..03, FR-ADM-01, NFR-SEC-02/10/12
// ---------------------------------------------------------------------------

/// FR-ADM-01 staff roles plus customers. Who may do what is enforced on every call (NFR-SEC-01).
enum Role {
  CUSTOMER
  OWNER
  MANAGER
  FLORIST
  DELIVERY_COORDINATOR
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_REQUESTED
}

enum Language {
  ar
  en
}

/// FR-LOC-02: Western digits by default, Arabic-Indic as a user setting.
enum Numerals {
  western
  arabic
}

enum OtpPurpose {
  LOGIN
}

enum OtpChannel {
  sms
  whatsapp
}

enum DevicePlatform {
  android
  ios
}

/// DR-01. Phone is unique per account and stored in E.164 (FR-CRT-09); email is stored lowercased.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @default("")
  phone           String?    @unique
  email           String?    @unique
  passwordHash    String?    @map("password_hash")
  googleSub       String?    @unique @map("google_sub")
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  language        Language   @default(ar)
  numerals        Numerals   @default(western)
  /// FR-NTF-05: marketing and reminder messages need opt-in; order messages do not.
  marketingOptIn  Boolean    @default(false) @map("marketing_opt_in")
  /// Free-text area picked at sign-up to suggest delivery (screen 03). Becomes a zone id in S5.
  homeArea        String?    @map("home_area")
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  termsAcceptedAt DateTime?  @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  devices             Device[]
  favorites           Favorite[]
  cart                Cart?
  addresses           Address[]
  orders              Order[]

  @@map("app_user")
}

/// Opaque refresh tokens, stored only as a SHA-256 hash. Each use rotates the token;
/// reusing an old one revokes its whole family (stolen-token detection).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

/// NFR-SEC-10: a code lives 5 minutes and allows 5 attempts. Only an HMAC of the code is stored.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose @default(LOGIN)
  channel    OtpChannel @default(sms)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_code")
}

/// FR-ACC-02: password reset by email. Single use, stored as a hash.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

/// Push targets (EI-SW-09). A device may belong to no user yet (guest).
model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  platform   DevicePlatform
  pushToken  String         @unique @map("push_token")
  appVersion String?        @map("app_version")
  locale     Language       @default(ar)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("device")
}

/// DR-20 / FR-ADM-09: who changed what and when. Append-only for everyone, enforced by
/// database triggers (NFR-SEC-12). No foreign key to users: entries outlive accounts.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole Role?    @map("actor_role")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Catalog (S2): DR-03..05, DR-12, DR-13, FR-CAT-*, FR-DLY-*, FR-INV-01/05/06
// ---------------------------------------------------------------------------

enum ProductKind {
  BOUQUET
  CAKE
  SWEET
  DRINK
  GIFT
}

enum PublishStatus {
  ACTIVE
  HIDDEN
}

enum OptionSelection {
  SINGLE
  MULTIPLE
}

enum DesignerItemType {
  /// Main flowers (screen 16). Each stem counts towards the size limits.
  FLOWER
  /// Secondary flowers such as gypsophila: in spec.flowers, counted as stems.
  FILLER
  GREEN
  WRAP
  RIBBON
  EXTRA
  /// Sweets sold by the piece for the sweets compartment of a split box (screen 19).
  SWEET
}

/// FR-CAT-01: flowers and bouquets, cakes and sweets, coffee and matcha, gifts.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  /// BBIcons name shown on the home screen.
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("category")
}

/// FR-CAT-11: birthday, love, graduation, newborn... Products list occasion slugs.
model Occasion {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  titleAr   String   @default("") @map("title_ar")
  titleEn   String   @default("") @map("title_en")
  heroImage String?  @map("hero_image")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("occasion")
}

/// DR-03. Prices are SYP minor units (1/100 pound, ADR 0011). The shown price is the
/// base price plus the default option of each group.
model Product {
  id                     String        @id @default(uuid()) @db.Uuid
  slug                   String        @unique
  categoryId             String        @map("category_id") @db.Uuid
  kind                   ProductKind
  nameAr                 String        @map("name_ar")
  nameEn                 String        @map("name_en")
  subtitleAr             String        @default("") @map("subtitle_ar")
  subtitleEn             String        @default("") @map("subtitle_en")
  descriptionAr          String        @default("") @map("description_ar")
  descriptionEn          String        @default("") @map("description_en")
  basePriceMinor         Int           @map("base_price_minor")
  /// Derived on every write: base plus the default options, so lists can filter and
  /// sort by the price customers see. "From" when the default is the cheapest choice.
  displayPriceMinor      Int           @default(0) @map("display_price_minor")
  priceFrom              Boolean       @default(false) @map("price_from")
  /// "Add to your gift" suggestions on the product page (screens 12, 14), as slugs.
  pairings               String[]      @default([])
  /// FR-DLV-05: the earliest delivery is now plus the longest lead time in the cart.
  leadTimeHours          Int           @default(0) @map("lead_time_hours")
  /// FR-CKE-05, e.g. ["nuts", "milk", "eggs", "gluten"].
  allergens              String[]      @default([])
  /// FR-CAT-02 filters (slugs).
  occasions              String[]      @default([])
  colors                 String[]      @default([])
  flowerTypes            String[]      @default([]) @map("flower_types")
  /// FR-INV-01: null means made to order, so there is no count to run out of.
  stockQuantity          Int?          @map("stock_quantity")
  status                 PublishStatus @default(ACTIVE)
  /// FR-DLY-02/03: staff put a product on today's list. It only counts on that date
  /// (Damascus), so it expires at midnight by itself (FR-DLY-05).
  dailyDate              DateTime?     @map("daily_date") @db.Date
  /// "Available today only": outside its daily date the product cannot be ordered.
  dailyOnly              Boolean       @default(false) @map("daily_only")
  limited                Boolean       @default(false)
  seasonal               Boolean       @default(false)
  bestSeller             Boolean       @default(false) @map("best_seller")
  /// Higher sorts first under "most ordered" until real order counts exist (S5).
  popularity             Int           @default(0)
  /// The bouquet spec this ready-made bouquet starts from in the designer (FR-CAT-07, S3).
  designerTemplate       Json?         @map("designer_template")
  /// FR-CKE-03: a message written on the cake, up to this many characters; null: none.
  inscriptionMaxLength   Int?          @map("inscription_max_length")
  /// Ready messages offered under the field (screen 13).
  inscriptionSuggestions String[]      @default([]) @map("inscription_suggestions")
  /// FR-CKE-04: the customer may attach a photo of the design they want.
  allowsReferenceImage   Boolean       @default(false) @map("allows_reference_image")
  /// Normalized names, subtitles and tags in both languages (FR-CAT-04).
  searchText             String        @default("") @map("search_text")
  branchId               String?       @map("branch_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     Category             @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  optionGroups ProductOptionGroup[]
  favorites    Favorite[]
  movements    StockMovement[]

  @@index([categoryId, status])
  @@index([dailyDate])
  @@map("product")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  altAr     String @default("") @map("alt_ar")
  altEn     String @default("") @map("alt_en")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_image")
}

/// DR-04: size, wrap, milk, sweetness, ice, gift card... (screens 12-14).
model ProductOptionGroup {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  key       String
  nameAr    String          @map("name_ar")
  nameEn    String          @map("name_en")
  selection OptionSelection @default(SINGLE)
  required  Boolean         @default(true)
  sortOrder Int             @default(0) @map("sort_order")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@unique([productId, key])
  @@map("product_option_group")
}

model ProductOption {
  id               String  @id @default(uuid()) @db.Uuid
  groupId          String  @map("group_id") @db.Uuid
  key              String
  nameAr           String  @map("name_ar")
  nameEn           String  @map("name_en")
  /// "15 roses", "8 - 10 people".
  detailAr         String  @default("") @map("detail_ar")
  detailEn         String  @default("") @map("detail_en")
  /// A swatch for wrap colors, e.g. "#7A1F3D".
  swatch           String?
  priceChangeMinor Int     @default(0) @map("price_change_minor")
  isDefault        Boolean @default(false) @map("is_default")
  sortOrder        Int     @default(0) @map("sort_order")

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@map("product_option")
}

/// DR-05: what the bouquet designer offers. The slug is the id used in bouquet specs.
model DesignerItem {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  type           DesignerItemType
  nameAr         String           @map("name_ar")
  nameEn         String           @map("name_en")
  /// Second line on screen 17, e.g. "بيج طبيعي".
  detailAr       String           @default("") @map("detail_ar")
  detailEn       String           @default("") @map("detail_en")
  unitPriceMinor Int              @map("unit_price_minor")
  swatch         String?
  colorTags      String[]         @default([]) @map("color_tags")
  occasionTags   String[]         @default([]) @map("occasion_tags")
  cutoutUrl      String?          @map("cutout_url")
  modelUrl       String?          @map("model_url")
  /// FR-INV-01 for wraps, ribbons and extras. Flowers and greens use DailyAvailability.
  stockQuantity  Int?             @map("stock_quantity")
  /// FR-INV-06: "MM-DD" window. Outside it the item is hidden.
  seasonFrom     String?          @map("season_from")
  seasonTo       String?          @map("season_to")
  status         PublishStatus    @default(ACTIVE)
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  daily     DailyAvailability[]
  movements StockMovement[]

  @@map("designer_item")
}

/// FR-DSG-04: stem limits per bouquet size (screen 15), set by the shop.
/// Keys match BouquetSpec.size: small, medium, large, luxury.
model DesignerSize {
  key       String   @id
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  minStems  Int      @map("min_stems")
  maxStems  Int      @map("max_stems")
  sortOrder Int      @default(0) @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("designer_size")
}

/// DR-13 / FR-DLY-01: stems available today. A row only counts on its own date
/// (Damascus), so "available today" expires at midnight by itself (FR-DLY-05).
model DailyAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  designerItemId String   @map("designer_item_id") @db.Uuid
  date           DateTime @db.Date
  quantity       Int
  limited        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  item DesignerItem @relation(fields: [designerItemId], references: [id], onDelete: Cascade)

  @@unique([designerItemId, date])
  @@index([date])
  @@map("daily_availability")
}

/// DR-12 / FR-INV-05: every change to a stock count, with who and why.
model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  designerItemId String?  @map("designer_item_id") @db.Uuid
  delta          Int
  quantityAfter  Int      @map("quantity_after")
  reason         String
  userId         String?  @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  designerItem DesignerItem? @relation(fields: [designerItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([designerItemId])
  @@map("stock_movement")
}

/// FR-ACC-06.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorite")
}

/// FR-CON-04: delivery, cancellation, privacy and terms pages in both languages.
model Page {
  slug      String   @id
  titleAr   String   @map("title_ar")
  titleEn   String   @map("title_en")
  bodyAr    String   @map("body_ar")
  bodyEn    String   @map("body_en")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("page")
}

// ---------------------------------------------------------------------------
// Cart (S4): DR-07, DR-08, FR-BOX-*, FR-CRT-*, FR-PAY-07
// ---------------------------------------------------------------------------

/// FR-BOX-01/02: a split box (screen 19). Compartments say what each part holds:
/// [{ "index": 0, "kind": "FLOWER", "nameAr": "ركن الورد", "nameEn": "Flowers", "capacity": 12 }, ...]
model BoxType {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  nameAr         String        @map("name_ar")
  nameEn         String        @map("name_en")
  detailAr       String        @default("") @map("detail_ar")
  detailEn       String        @default("") @map("detail_en")
  basePriceMinor Int           @map("base_price_minor")
  compartments   Json
  status         PublishStatus @default(ACTIVE)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("box_type")
}

/// FR-CRT-03: a signed-in customer's cart, kept on the server so it follows them
/// between phones. Lines are what the app sends (no prices); every quote prices
/// them again from the database.
model Cart {
  userId    String   @id @map("user_id") @db.Uuid
  lines     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart")
}

enum CouponType {
  PERCENT
  FIXED
}

/// FR-CRT-07: discount codes. Stored upper-case; the customer may type any case.
model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique
  type           CouponType
  /// Percent for PERCENT (1-100); SYP minor units for FIXED.
  value          Int
  minOrderMinor  Int        @default(0) @map("min_order_minor")
  startsAt       DateTime?  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?  @map("ends_at") @db.Timestamptz(3)
  /// Uses allowed in total; null: no limit. Counted when an order is placed (S5).
  maxRedemptions Int?       @map("max_redemptions")
  redemptions    Int        @default(0)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("coupon")
}

// ---------------------------------------------------------------------------
// Delivery and orders (S5): DR-09..11, DR-14..16, FR-DLV-*, FR-ORD-*, FR-INV-02/03
// ---------------------------------------------------------------------------

/// FR-DLV-01/02: an area the shop delivers to. polygon is GeoJSON ring order:
/// [[lng, lat], ...] (first point = last point not required).
model DeliveryZone {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  polygon   Json
  feeMinor  Int      @map("fee_minor")
  /// Shown as "المدة التقريبية" (screen 22); free text set by the shop.
  etaAr     String   @default("") @map("eta_ar")
  etaEn     String   @default("") @map("eta_en")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("delivery_zone")
}

/// FR-DLV-04: a delivery slot kept for one checkout for a few minutes, so two
/// customers cannot both take the last place.
model SlotHold {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  start     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([date, start])
  @@map("slot_hold")
}

/// FR-ACC-04: saved addresses (screen 22 "احفظ العنوان", screen 29 in S7).
model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  latitude  Float
  longitude Float
  zoneSlug  String?  @map("zone_slug")
  area      String   @default("")
  landmark  String   @default("")
  building  String   @default("")
  floor     String   @default("")
  details   String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address")
}

/// Design diagram 3 (FR-ORD-02). Payment has its own status.
enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

/// PENDING: not paid yet (cash until handed over; Sham Cash until a receipt).
/// SUBMITTED: the customer sent a Sham Cash reference or receipt (S6).
/// FAILED: staff could not match it; the customer may send it again.
enum PaymentStatus {
  PENDING
  SUBMITTED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  SHAMCASH
  STRIPE
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

/// DR-09. Prices, rate, address and lines are copied in when the order is
/// placed, so later changes to the catalog never change an order (FR-PAY-06).
model Order {
  id                String        @id @default(uuid()) @db.Uuid
  number            String        @unique
  userId            String?       @map("user_id") @db.Uuid
  status            OrderStatus   @default(NEW)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod     PaymentMethod @map("payment_method")
  fulfillment       Fulfillment
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  recipientName     String        @map("recipient_name")
  recipientPhone    String        @map("recipient_phone")
  hideSender        Boolean       @default(false) @map("hide_sender")
  /// Delivery address as entered (null for pickup).
  address           Json?
  zoneSlug          String?       @map("zone_slug")
  slotDate          DateTime      @map("slot_date") @db.Date
  slotStart         String        @map("slot_start")
  slotEnd           String        @map("slot_end")
  callBeforeArrival Boolean       @default(false) @map("call_before_arrival")
  whatsappConfirm   Boolean       @default(false) @map("whatsapp_confirm")
  notes             String        @default("")
  couponCode        String?       @map("coupon_code")
  usdRate           String        @map("usd_rate")
  itemsMinor        Int           @map("items_minor")
  assemblyFeeMinor  Int           @map("assembly_fee_minor")
  discountMinor     Int           @map("discount_minor")
  deliveryFeeMinor  Int           @map("delivery_fee_minor")
  roundingMinor     Int           @map("rounding_minor")
  totalMinor        Int           @map("total_minor")
  totalUsdCents     Int           @map("total_usd_cents")
  /// FR-PAY-10: an online payment not made by then cancels the order.
  paymentDueAt      DateTime?     @map("payment_due_at") @db.Timestamptz(3)
  /// The shop's note when it rejects a receipt (screen 38).
  paymentNote       String        @default("") @map("payment_note")
  branchId          String?       @map("branch_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  history      OrderStatusHistory[]
  reservations StockReservation[]
  payments     PaymentEvent[]

  @@index([userId, createdAt])
  @@index([status, slotDate])
  @@index([paymentStatus, paymentDueAt])
  @@index([slotDate, slotStart])
  @@map("order")
}

/// DR-10: one line as it was ordered.
model OrderLine {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  position       Int
  kind           String
  titleAr        String  @map("title_ar")
  titleEn        String  @map("title_en")
  summaryAr      String  @default("") @map("summary_ar")
  summaryEn      String  @default("") @map("summary_en")
  qty            Int
  unitPriceMinor Int     @map("unit_price_minor")
  totalMinor     Int     @map("total_minor")
  leadTimeHours  Int     @default(0) @map("lead_time_hours")
  /// What the app sent: product slug and options, or the bouquet/box spec.
  choice         Json
  imageUrl       String? @map("image_url")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_line")
}

/// DR-11 / FR-ORD-03: every status change, who made it, and why.
model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  from      OrderStatus?
  to        OrderStatus
  byUserId  String?      @map("by_user_id") @db.Uuid
  note      String       @default("")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// FR-INV-02: stock taken by an order, given back if it is cancelled.
model StockReservation {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  designerItemId String?   @map("designer_item_id") @db.Uuid
  /// For stems from the daily list: which day's list they came from.
  dailyDate      DateTime? @map("daily_date") @db.Date
  qty            Int
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("stock_reservation")
}

/// FR-CRT-10: the answer to a POST /v1/orders, kept 24 hours by its
/// Idempotency-Key, so a retry after a dropped connection never orders twice.
model IdempotencyKey {
  key         String   @id
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("idempotency_key")
}

/// FR-PAY-09: every step of an order's payment, with method, reference,
/// amount, currency and who did it.
model PaymentEvent {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  kind        String
  method      PaymentMethod
  status      PaymentStatus
  amountMinor Int           @map("amount_minor")
  currency    String        @default("SYP")
  reference   String?
  receiptUrl  String?       @map("receipt_url")
  note        String        @default("")
  byUserId    String?       @map("by_user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_event")
}
